<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <!-- Khi chạy, app tự dò instance SQL Server và tạo CSDL nếu chưa có.
         Có thể đổi Data Source cho khớp máy: ., .\SQLEXPRESS, (localdb)\MSSQLLocalDB -->
    <add name="HotelDB"
         connectionString="Data Source=.\MSSQLSERVER03;Initial Catalog=HotelDB;Integrated Security=True;TrustServerCertificate=True;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
