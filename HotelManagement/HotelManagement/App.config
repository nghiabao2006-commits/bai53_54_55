<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <!-- Có thể đổi Data Source thành .\SQLEXPRESS hoặc (localdb)\MSSQLLocalDB -->
    <add name="HotelDB"
         connectionString="Data Source=.;Initial Catalog=HotelDB;Integrated Security=True;TrustServerCertificate=True;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
