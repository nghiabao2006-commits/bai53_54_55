<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <!-- Đổi Data Source cho khớp SQL Server đang chạy trên máy (VD: ., .\SQLEXPRESS, .\MSSQLSERVER03) -->
    <add name="CafePOSDB"
         connectionString="Data Source=.\MSSQLSERVER03;Initial Catalog=CafePOSDB;Integrated Security=True;TrustServerCertificate=True;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
